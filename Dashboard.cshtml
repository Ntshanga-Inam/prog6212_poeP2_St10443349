@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h2>
            <div class="btn-group">
                <button class="btn btn-outline-primary active" onclick="filterClaims('all')">All</button>
                <button class="btn btn-outline-primary" onclick="filterClaims('pending')">Pending</button>
                <button class="btn btn-outline-primary" onclick="filterClaims('approved')">Approved</button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Statistics Cards -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Total Claims
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">12</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-file-invoice-dollar fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Approved Claims
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">8</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Pending Approval
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">3</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Total Amount
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">R 95,400</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Claims -->
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Recent Claims</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="claimsTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Claim ID</th>
                                <th>Month</th>
                                <th>Hours</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Submitted</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#0012</td>
                                <td>March 2024</td>
                                <td>38</td>
                                <td>R 9,500</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td>15 Mar 2024</td>
                            </tr>
                            <tr>
                                <td>#0011</td>
                                <td>February 2024</td>
                                <td>42</td>
                                <td>R 10,500</td>
                                <td><span class="badge bg-success">Approved</span></td>
                                <td>14 Feb 2024</td>
                            </tr>
                            <tr>
                                <td>#0010</td>
                                <td>January 2024</td>
                                <td>40</td>
                                <td>R 10,000</td>
                                <td><span class="badge bg-success">Approved</span></td>
                                <td>15 Jan 2024</td>
                            </tr>
                            <tr>
                                <td>#0009</td>
                                <td>December 2023</td>
                                <td>35</td>
                                <td>R 8,750</td>
                                <td><span class="badge bg-success">Approved</span></td>
                                <td>18 Dec 2023</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Create", "Claim")" class="btn btn-primary btn-block">
                        <i class="fas fa-plus-circle me-2"></i>Submit New Claim
                    </a>
                    <a href="@Url.Action("Index", "Claim")" class="btn btn-outline-primary btn-block">
                        <i class="fas fa-list me-2"></i>View My Claims
                    </a>
                    <a href="@Url.Action("Index", "Approval")" class="btn btn-outline-warning btn-block">
                        <i class="fas fa-check-circle me-2"></i>Review Approvals
                        <span class="badge bg-danger ms-1">3</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Status Overview -->
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Claim Status Overview</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie pt-4 pb-2">
                    <canvas id="statusChart" width="100%" height="150"></canvas>
                </div>
                <div class="mt-4 text-center small">
                    <span class="mr-2">
                        <i class="fas fa-circle text-success"></i> Approved
                    </span>
                    <span class="mr-2">
                        <i class="fas fa-circle text-warning"></i> Pending
                    </span>
                    <span class="mr-2">
                        <i class="fas fa-circle text-danger"></i> Rejected
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Pie Chart Example
        var ctx = document.getElementById("statusChart");
        var statusChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ["Approved", "Pending", "Rejected"],
                datasets: [{
                    data: [8, 3, 1],
                    backgroundColor: ['#1cc88a', '#f6c23e', '#e74a3b'],
                    hoverBackgroundColor: ['#17a673', '#dda20a', '#be2617'],
                    hoverBorderColor: "rgba(234, 236, 244, 1)",
                }],
            },
            options: {
                maintainAspectRatio: false,
                tooltips: {
                    backgroundColor: "rgb(255,255,255)",
                    bodyFontColor: "#858796",
                    borderColor: '#dddfeb',
                    borderWidth: 1,
                    xPadding: 15,
                    yPadding: 15,
                    displayColors: false,
                    caretPadding: 10,
                },
                legend: {
                    display: false
                },
                cutoutPercentage: 80,
            },
        });

        function filterClaims(status) {
            // Update active button
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            // Simple filtering logic (in a real app, this would call an API)
            const rows = document.querySelectorAll('#claimsTable tbody tr');
            rows.forEach(row => {
                const statusBadge = row.querySelector('.badge').textContent.toLowerCase();
                if (status === 'all' || statusBadge === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Initialize dashboard
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Dashboard loaded successfully');
        });
    </script>
}
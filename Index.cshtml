@model List<CMCS.Models.Claim>
@{
    ViewData["Title"] = "Claims for Approval";
    var userRole = "Coordinator"; // This would come from authentication
}

<h2><i class="fas fa-tasks me-2"></i>Claims Pending Approval</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No claims pending approval at this time.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Claim ID</th>
                            <th>Lecturer</th>
                            <th>Month</th>
                            <th>Total Hours</th>
                            <th>Hourly Rate</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td><strong>#@claim.ClaimId</strong></td>
                                <td>Dr. John Smith</td>
                                <td>@claim.ClaimMonth.ToString("MMMM yyyy")</td>
                                <td>@claim.TotalHours</td>
                                <td>R @claim.HourlyRate</td>
                                <td>R @claim.Amount.ToString("N2")</td>
                                <td>
                                    @GetStatusBadge(claim.Status)
                                </td>
                                <td>@claim.SubmittedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a href="@Url.Action("Review", "Approval", new { id = claim.ClaimId })"
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-search me-1"></i>Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@functions {
    public string GetStatusBadge(string status)
    {
        return status switch
        {
            "Submitted" => "<span class='badge bg-warning'><i class='fas fa-clock me-1'></i>Submitted</span>",
            "With Coordinator" => "<span class='badge bg-info'><i class='fas fa-user-check me-1'></i>With Coordinator</span>",
            "With Manager" => "<span class='badge bg-primary'><i class='fas fa-user-tie me-1'></i>With Manager</span>",
            "Approved" => "<span class='badge bg-success'><i class='fas fa-check-circle me-1'></i>Approved</span>",
            "Rejected" => "<span class='badge bg-danger'><i class='fas fa-times-circle me-1'></i>Rejected</span>",
            _ => "<span class='badge bg-secondary'>" + status + "</span>"
        };
    }
}
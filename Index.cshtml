@model List<CMCS.Models.Claim>
@{
    ViewData["Title"] = "My Claims";
}

<h2>My Claims</h2>
<div class="mb-3">
    <a href="@Url.Action("Create", "Claim")" class="btn btn-success">Submit New Claim</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Claim ID</th>
                    <th>Month</th>
                    <th>Total Hours</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.ClaimId</td>
                        <td>@claim.ClaimMonth.ToString("MMMM yyyy")</td>
                        <td>@claim.TotalHours</td>
                        <td>R @claim.Amount</td>
                        <td>
                            <span class="badge bg-@(claim.Status == "Approved" ? "success" : claim.Status == "Rejected" ? "danger" : "warning")">
                                @claim.Status
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Claim", new { id = claim.ClaimId })" class="btn btn-sm btn-info">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>